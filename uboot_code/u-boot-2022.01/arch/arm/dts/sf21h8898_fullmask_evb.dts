/dts-v1/;
#include "sf21h8898_fullmask.dtsi"

/ {
	model = "sf21h8898";
	compatible = "siflower,sf21h8898";

	chosen {
		stdout-path = &uart1;
		tick-timer = &timer0;
	};

};

&uart1 {
	u-boot,dm-pre-reloc;
};

&watchdog {
	u-boot,dm-pre-reloc;
};

&timer0 {
	u-boot,dm-pre-reloc;
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <20000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&i2c0 {
	status = "disabled";

	eeprom@0 {
		compatible = "i2c-eeprom";
		reg = <0x57>;
		u-boot,i2c-offset-len = <2>;
	};
};

&gmac0 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	phy-handle = <&ytphy0>;
};

&gmac1 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	phy-handle = <&ytphy1>;
};

&gmac2 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	phy-handle = <&ytphy2>;
};

&gmac3 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	phy-handle = <&ytphy3>;
};

&gmac5 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	tx-internal-delay-ps = <6762>;
	rx-internal-delay-ps = <1960>;
	phy-handle = <&rtk8211f>;
};

&mdio0 {
	rtk8211f: ethernet-phy@2 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x2>;
		reset-gpios = <&gpio 39 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <100000>;
	};

	ytphy0: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x8>;
		reset-gpios = <&gpio 22 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <100000>;
	};

	ytphy1: ethernet-phy@9 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x9>;
	};

	ytphy2: ethernet-phy@a {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0xa>;
	};

	ytphy3: ethernet-phy@b {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0xb>;
	};
};

&xpcs0 {
	enable;
};

&xpcs1 {
	enable;
};
