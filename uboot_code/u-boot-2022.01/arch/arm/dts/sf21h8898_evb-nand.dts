/dts-v1/;
#include "sf21h8898.dtsi"

/ {
	model = "sf21h8898";
	compatible = "siflower,sf21h8898";

	chosen {
		stdout-path = &uart1;
		tick-timer = &timer0;
	};

};

&uart1 {
	u-boot,dm-pre-reloc;
};

&watchdog {
	u-boot,dm-pre-reloc;
};

&timer0 {
	u-boot,dm-pre-reloc;
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <20000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&gmac0 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	phy-handle = <&ytphy0>;
};

&gmac1 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	phy-handle = <&ytphy1>;
};

&gmac2 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	phy-handle = <&ytphy2>;
};

&gmac3 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	phy-handle = <&ytphy3>;
};

&gmac4 {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];
	tx-internal-delay-ps = <5700>;

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};

&xgmac {
	status = "okay";
	local-mac-address = [10 23 45 67 89 ab];

	fixed-link {
		speed = <10000>;
		full-duplex;
		pause;
	};
};

&mdio {
	ytphy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
		reset-gpios = <&gpio 22 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <100000>;
	};

	ytphy1: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};

	ytphy2: ethernet-phy@2 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x2>;
	};

	ytphy3: ethernet-phy@3 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x3>;
	};
};

&xpcs0 {
	enable;
};

&xpcs1 {
	enable;
};
