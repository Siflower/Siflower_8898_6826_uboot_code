/dts-v1/;
#include "sf21h8898_bpi-rv2.dtsi"
/ {
	model = "BananaPi BPI-RV2 (Booting from NOR)";
	compatible = "bananapi,bpi-rv2-nor", "siflower,sf21h8898";

	chosen {
		stdout-path = &uart1;
		tick-timer = &timer;
	};
};

&spi0 {
	status = "okay";
	num-cs = <2>;
	cs-gpios = <&gpio 5 GPIO_ACTIVE_LOW>, <&gpio 36 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <35000000>;
		spi-tx-bus-width = <2>;
		spi-rx-bus-width = <2>;
		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition0@0 {
				label = "U-BOOT";
				reg = <0x0 0x90000>;
			};

			factory: partition@90000 {
				label = "factory";
				reg = <0x90000 0x10000>;
			};

			partition@a0000 {
				label = "FIRMWARE";
				reg = <0xa0000 0xf60000>;
				compatible = "denx,fit";
			};
		};
	};

	flash@1 {
		compatible = "spi-nand";
		reg = <1>;
		spi-max-frequency = <35000000>;
		spi-tx-bus-width = <2>;
		spi-rx-bus-width = <2>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};
