/dts-v1/;
#include "sf21h8898_siflower_one.dtsi"
/ {
	model = "Siflower One (Booting from NAND)";
	compatible = "siflower,one-nand", "siflower,sf21h8898";

	chosen {
		stdout-path = &uart1;
		tick-timer = &timer;
	};

};

&spi0 {
	status = "okay";
	num-cs = <2>;
	cs-gpios = <&gpio 5 GPIO_ACTIVE_LOW>, <&gpio 36 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <35000000>;
		spi-tx-bus-width = <2>;
		spi-rx-bus-width = <2>;
		#address-cells = <1>;
		#size-cells = <1>;

		 partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "FBL";
				reg = <0x0 0x20000>;
			};

			partition@20000 {
				label = "FIRMWARE";
				reg = <0x20000 0x7fe0000>;
			};
		};
	};

	flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <35000000>;
		spi-tx-bus-width = <2>;
		spi-rx-bus-width = <2>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};
